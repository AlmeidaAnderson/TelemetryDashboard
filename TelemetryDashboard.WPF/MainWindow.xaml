<Window x:Class="TelemetryDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TelemetryDashboard.ViewModels"
        mc:Ignorable="d"
        Title="Telemetry Dashboard" Height="700" Width="1200"
        Background="#F5F5F5">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- Connection Settings -->
        <GroupBox Grid.Row="0" Header="Connection Settings">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Serial Port:" Style="{StaticResource LabelStyle}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePorts}"
                         SelectedItem="{Binding SelectedPort}"
                         IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>

                <TextBlock Grid.Column="2" Text="Baud Rate:" Style="{StaticResource LabelStyle}"/>
                <TextBox Grid.Column="3" Text="{Binding BaudRate}"
                        IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>

                <Button Grid.Column="4" Content="Refresh Ports" Command="{Binding RefreshPortsCommand}"
                       IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding IsConnected, Converter={StaticResource ConnectButtonTextConverter}}"
                           Command="{Binding ConnectCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#FFE57373"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Background" Value="#FF81C784"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Control Panel -->
        <GroupBox Grid.Row="1" Header="Control Panel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="{Binding IsReading, Converter={StaticResource ReadButtonTextConverter}}"
                           Command="{Binding ToggleReadingCommand}"
                           IsEnabled="{Binding IsConnected}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReading}" Value="True">
                                        <Setter Property="Background" Value="#FFFFB74D"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReading}" Value="False">
                                        <Setter Property="Background" Value="#FF64B5F6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <CheckBox Content="ASCII Mode" IsChecked="{Binding UseAsciiMode}"
                             VerticalAlignment="Center" Margin="10,0"
                             IsEnabled="{Binding IsReading, Converter={StaticResource InverseBoolConverter}}"/>

                    <CheckBox Content="Auto Save" IsChecked="{Binding AutoSave}"
                             VerticalAlignment="Center" Margin="10,0"/>

                    <CheckBox Content="Enable Logging" IsChecked="{Binding EnableLogging}"
                             VerticalAlignment="Center" Margin="10,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Clear Display" Command="{Binding ClearDisplayCommand}"/>
                    <Button Content="Load Recent" Command="{Binding LoadRecentDataCommand}"/>
                    <Button Content="Export JSON" Command="{Binding ExportToJsonCommand}"/>
                    <Button Content="Export CSV" Command="{Binding ExportToCsvCommand}"/>
                    <Button Content="Open Logs" Command="{Binding OpenLogFolderCommand}"/>
                    <Button Content="Clear All Data" Command="{Binding ClearAllDataCommand}"
                           Background="#FFFF6B6B"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Telemetry Data Display -->
        <GroupBox Grid.Row="2" Header="Telemetry Data">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Latest Values -->
                <Border Grid.Row="0" Background="#E3F2FD" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Timestamp" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Text="{Binding LatestTelemetry.Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}"
                                     FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Temperature" FontWeight="Bold" FontSize="11"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <Run Text="{Binding LatestTelemetry.Temperature, StringFormat='{}{0:F2}'}"/>
                                <Run Text="°C"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pressure" FontWeight="Bold" FontSize="11"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <Run Text="{Binding LatestTelemetry.Pressure, StringFormat='{}{0:F2}'}"/>
                                <Run Text="kPa"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Altitude" FontWeight="Bold" FontSize="11"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <Run Text="{Binding LatestTelemetry.Altitude, StringFormat='{}{0:F2}'}"/>
                                <Run Text="m"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Velocity" FontWeight="Bold" FontSize="11"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <Run Text="{Binding LatestTelemetry.Velocity, StringFormat='{}{0:F2}'}"/>
                                <Run Text="m/s"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="5">
                            <TextBlock Text="Acceleration" FontWeight="Bold" FontSize="11"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <Run Text="{Binding LatestTelemetry.Acceleration, StringFormat='{}{0:F2}'}"/>
                                <Run Text="m/s²"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Data Grid -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding TelemetryList}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         AlternatingRowBackground="#F9F9F9"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}" Width="180"/>
                        <DataGridTextColumn Header="Temperature (°C)" Binding="{Binding Temperature, StringFormat='{}{0:F2}'}" Width="*"/>
                        <DataGridTextColumn Header="Pressure (kPa)" Binding="{Binding Pressure, StringFormat='{}{0:F2}'}" Width="*"/>
                        <DataGridTextColumn Header="Altitude (m)" Binding="{Binding Altitude, StringFormat='{}{0:F2}'}" Width="*"/>
                        <DataGridTextColumn Header="Velocity (m/s)" Binding="{Binding Velocity, StringFormat='{}{0:F2}'}" Width="*"/>
                        <DataGridTextColumn Header="Accel (m/s²)" Binding="{Binding Acceleration, StringFormat='{}{0:F2}'}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Status Log -->
        <GroupBox Grid.Row="3" Header="Status Log">
            <ListBox ItemsSource="{Binding StatusMessages}"
                    FontFamily="Consolas"
                    FontSize="11"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </GroupBox>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" VerticalAlignment="Bottom" Height="25" Background="#E0E0E0">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Records in DB:"/>
                    <Run Text="{Binding TotalRecordsCount}" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Display:"/>
                    <Run Text="{Binding TelemetryList.Count}" FontWeight="Bold"/>
                    <Run Text="/"/>
                    <Run Text="{Binding MaxDisplayRecords}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Status:"/>
                    <Run Text="{Binding IsReading, Converter={StaticResource StatusTextConverter}}" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
