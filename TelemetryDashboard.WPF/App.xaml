<Application x:Class="TelemetryDashboard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TelemetryDashboard.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Value Converters -->
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:ConnectButtonTextConverter x:Key="ConnectButtonTextConverter"/>
        <converters:ReadButtonTextConverter x:Key="ReadButtonTextConverter"/>
        <converters:StatusTextConverter x:Key="StatusTextConverter"/>
    </Application.Resources>
</Application>
